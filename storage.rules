rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function ownsPath(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validReceipt() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/jpeg|image/png|application/pdf)$');
    }

    match /users/{userId}/jobs/{jobId}/receipts/{receiptId}/{filename} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validReceipt();
      allow delete: if ownsPath(userId);
    }
  }
}
