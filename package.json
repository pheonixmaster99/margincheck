{
  "name": "margincheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:rules": "npx firebase-tools emulators:exec --project demo-margincheck --only auth,firestore,storage \"tsx --test tests/rules/*.test.ts\"",
    "check:openai": "node --env-file=.env.local scripts/check-openai.mjs",
    "check:firebase-admin": "node --env-file=.env.local scripts/check-firebase-admin.mjs",
    "check:receipt-analysis": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-receipt-analysis.ts"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.5",
    "openai": "^7.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
